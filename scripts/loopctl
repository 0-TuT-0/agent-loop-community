#!/bin/bash
# 总控的状态操作入口：总控所有权（代次）、原子认领、票头字段修改、意图与结果记录、恢复用的 git 核对。
# 所有写操作都在运行目录的互斥锁内执行，并先核对「当前总控 = 调用者，代次一致」。
# worker 不用本工具：worker 只直接改票头的 Run 字段、在 Comments 追加块。
#
# 全局参数：-r <运行目录>  -o <总控标识>  -g <代次>
# 命令：
#   acquire                       取得总控所有权，打印新代次。他人持有且租约未过期时失败（退出码 3）
#   heartbeat                     续租（代次不符时失败，退出码 3）
#   check                         核对调用者是否仍是有效总控（退出码 0 / 3）
#   owner                         打印当前所有者（只读）
#   claim <票> <Run-id> [起始Run]  原子认领：Run 必须等于起始状态（默认 idle），改为 dispatched 并写 Run-id
#   transition <票> <从> <到>      Run 必须等于「从」才改为「到」
#   set <票> <字段> <值>           改写或新增票头字段
#   intent <键> <动作> [说明]      记录即将执行的跨系统动作（启动、集成、推送…）
#   result <键> <结果>             记录该动作的结果
#   pending                        列出有意图、无结果的动作（恢复时逐个核对现场）
#   merged-check <仓库> <阶段分支> <票分支>   票分支 HEAD 已在阶段分支中时打印合入提交 SHA（退出码 0），否则退出码 1
#   verify-commit <仓库> <票分支> <回报SHA>  回报 SHA 等于票分支 HEAD 时退出码 0，否则打印差异、退出码 1
# 环境变量：LOOP_LEASE 租约秒数（默认 600）
set -uo pipefail

RD= OWNER= GEN=
while [ $# -gt 0 ]; do
  case $1 in
    -r) RD=$2; shift 2 ;;
    -o) OWNER=$2; shift 2 ;;
    -g) GEN=$2; shift 2 ;;
    *) break ;;
  esac
done
cmd=${1:-}; shift || true
LEASE=${LOOP_LEASE:-600}

die() { echo "loopctl: $*" >&2; exit "${CODE:-1}"; }
now() { date +%s; }
iso() { date +%Y-%m-%dT%H:%M:%S; }
mtime() { stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null || echo 0; }

need_rd() { [ -n "$RD" ] || die "缺少 -r <运行目录>"; mkdir -p "$RD/intents/done"; touch "$RD/events.log"; }

lock() {
  local d="$RD/.lock" i=0
  while ! mkdir "$d" 2>/dev/null; do
    if [ -d "$d" ] && [ $(( $(now) - $(mtime "$d") )) -gt 60 ]; then rmdir "$d" 2>/dev/null; continue; fi
    i=$((i+1)); [ $i -gt 300 ] && CODE=4 die "取锁超时：$d"
    sleep 0.1
  done
  trap 'rmdir "$RD/.lock" 2>/dev/null' EXIT
}

owner_get() { # 输出：代次 标识 心跳
  if [ -f "$RD/coordinator" ]; then
    awk -F= '/^gen=/{g=$2} /^id=/{i=$2} /^heartbeat=/{h=$2} END{print (g==""?0:g), (i==""?"-":i), (h==""?0:h)}' "$RD/coordinator"
  else echo "0 - 0"; fi
}
owner_put() { printf 'gen=%s\nid=%s\nheartbeat=%s\n' "$1" "$2" "$3" > "$RD/coordinator.tmp" && mv "$RD/coordinator.tmp" "$RD/coordinator"; }
log_event() { printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$(iso)" "${GEN:--}" "${OWNER:--}" "$1" "${2:--}" "${3:-}" >> "$RD/events.log"; }

require_owner() { # 在锁内调用：核对并续租
  [ -n "$OWNER" ] && [ -n "$GEN" ] || die "缺少 -o <总控标识> -g <代次>"
  read -r g i h <<< "$(owner_get)"
  if [ "$g" != "$GEN" ] || [ "$i" != "$OWNER" ]; then
    CODE=3 die "已不是有效总控（当前 代次 ${g}，所有者 ${i}；调用者 代次 ${GEN}，${OWNER}）。只能读取状态。"
  fi
  owner_put "$g" "$i" "$(now)"
}

field() { grep -m1 -E "^\**$2:?\**:?[[:space:]]" "$1" 2>/dev/null | sed -E "s/^\**$2:?\**:?[[:space:]]*//"; }
run_of() { local r; r=$(field "$1" Run | awk '{print $1}'); echo "${r:-idle}"; }
set_field() { # set_field <票> <字段> <值>：替换第一处该字段（保留加粗写法），没有则插在 Run/Status 行之后（都没有则插在标题后）
  local f=$1 k=$2 v=$3 tmp
  tmp="$f.loopctl.$$"
  if grep -qE "^\**$k:?\**:?([[:space:]]|$)" "$f"; then
    awk -v k="$k" -v v="$v" '
      !done && $0 ~ "^\\**" k ":?\\**:?([ \t]|$)" { pre = ($0 ~ /^\*\*/) ? "**" k ":** " : k ": "; print pre v; done=1; next }
      { print }' "$f" > "$tmp"
  else
    local ln
    ln=$(grep -nE '^\**(Run|Status):?\**:?([[:space:]]|$)' "$f" | tail -1 | cut -d: -f1)
    ln=${ln:-1}
    awk -v n="$ln" -v line="$k: $v" '{ print } NR==n { print line }' "$f" > "$tmp"
  fi
  mv "$tmp" "$f"
}

case $cmd in
  acquire)
    need_rd; [ -n "$OWNER" ] || die "缺少 -o <总控标识>"
    lock
    read -r g i h <<< "$(owner_get)"
    if [ "$i" != "-" ] && [ "$i" != "$OWNER" ] && [ $(( $(now) - h )) -lt "$LEASE" ]; then
      CODE=3 die "总控所有权由 $i 持有（代次 ${g}，租约未过期）。如确认对方已停止，等租约过期（${LEASE}s）后再取。"
    fi
    GEN=$((g+1)); owner_put "$GEN" "$OWNER" "$(now)"; log_event acquire - "上一任：$i 代次 $g"
    echo "$GEN" ;;
  heartbeat)
    need_rd; lock; require_owner; echo ok ;;
  check)
    need_rd; read -r g i h <<< "$(owner_get)"
    if [ "$g" = "$GEN" ] && [ "$i" = "$OWNER" ]; then echo ok; else echo "superseded：当前 代次 ${g}，所有者 $i"; exit 3; fi ;;
  owner)
    need_rd; read -r g i h <<< "$(owner_get)"; echo "代次 ${g}，所有者 ${i}，心跳 $(( $(now) - h )) 秒前" ;;
  claim)
    need_rd; t=${1:?票} rid=${2:?Run-id} from=${3:-idle}
    [ -f "$t" ] || die "票不存在：$t"
    lock; require_owner
    cur=$(run_of "$t")
    [ "$cur" = "$from" ] || CODE=5 die "认领失败：$t 的 Run 是 ${cur}，不是 ${from}（可能已被派工）"
    set_field "$t" Run dispatched; set_field "$t" Run-id "$rid"
    log_event claim "$t" "$rid"; echo "claimed $rid" ;;
  transition)
    need_rd; t=${1:?票} from=${2:?从} to=${3:?到}
    lock; require_owner
    cur=$(run_of "$t")
    [ "$cur" = "$from" ] || CODE=5 die "转换失败：$t 的 Run 是 ${cur}，不是 $from"
    set_field "$t" Run "$to"; log_event transition "$t" "$from->$to"; echo "$from->$to" ;;
  set)
    need_rd; t=${1:?票} k=${2:?字段} v=${3-}
    lock; require_owner
    set_field "$t" "$k" "$v"; log_event set "$t" "$k=$v"; echo ok ;;
  intent)
    need_rd; key=${1:?键} act=${2:?动作} detail=${3:-}
    lock; require_owner
    [ -f "$RD/intents/done/$key" ] && CODE=5 die "动作已有结果：${key}（$(cat "$RD/intents/done/$key" | tail -1)）"
    printf 'action=%s\ndetail=%s\ntime=%s\ngen=%s\n' "$act" "$detail" "$(iso)" "$GEN" > "$RD/intents/$key"
    log_event intent - "$key $act $detail"; echo ok ;;
  result)
    need_rd; key=${1:?键} res=${2:?结果}
    lock; require_owner
    [ -f "$RD/intents/$key" ] || die "没有这个意图：$key"
    { cat "$RD/intents/$key"; printf 'result=%s\nresult_time=%s\n' "$res" "$(iso)"; } > "$RD/intents/done/$key" && rm -f "$RD/intents/$key"
    log_event result - "$key $res"; echo ok ;;
  pending)
    need_rd
    for f in "$RD"/intents/*; do [ -f "$f" ] || continue; printf '%s\t%s\n' "$(basename "$f")" "$(tr '\n' ' ' < "$f")"; done ;;
  merged-check)
    repo=${1:?仓库} stage=${2:?阶段分支} tb=${3:?票分支}
    if git -C "$repo" merge-base --is-ancestor "$tb" "$stage" 2>/dev/null; then
      m=$(git -C "$repo" log --merges --ancestry-path --reverse --format=%H "$tb..$stage" 2>/dev/null | head -1)
      echo "${m:-$(git -C "$repo" rev-parse "$tb")}"
    else exit 1; fi ;;
  verify-commit)
    repo=${1:?仓库} tb=${2:?票分支} rep=${3:?回报SHA}
    head=$(git -C "$repo" rev-parse "$tb" 2>/dev/null) || die "票分支不存在：$tb"
    full=$(git -C "$repo" rev-parse --verify -q "$rep^{commit}" 2>/dev/null || true)
    if [ -n "$full" ] && [ "$full" = "$head" ]; then echo "ok $head"; else echo "不一致：回报 ${rep}，票分支 HEAD $head"; exit 1; fi ;;
  *) sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
